{
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "lib/**"
    }
  },
  "rewrites": [
    { "source": "/api/razorpay-webhook", "destination": "/api/counter-invoice" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/sitemap.xml", "destination": "/api/keepalive?action=sitemap" },
    { "source": "/:slug([a-zA-Z0-9-]+)/sitemap.xml", "destination": "/api/keepalive?action=sitemap&slug=:slug" },
    { "source": "/:slug([a-zA-Z0-9-]+)", "destination": "/api/keepalive?action=page&slug=:slug" },
    { "source": "/:slug([a-zA-Z0-9-]+)/menu", "destination": "/api/keepalive?action=page&slug=:slug" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/keepalive",                            "schedule": "0 12 * * *" },
    { "path": "/api/subscription/daily-digest",      "schedule": "35 11 * * *" },
    { "path": "/api/subscription/auto-deliver?slot=08-09", "schedule": "0 4 * * *"  },
    { "path": "/api/subscription/auto-deliver?slot=12-14", "schedule": "0 9 * * *"  },
    { "path": "/api/subscription/auto-deliver?slot=19-21", "schedule": "0 16 * * *" }
  ]
}
